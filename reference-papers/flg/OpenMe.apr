(SEd.34
	Name:	"FLG.Main"
	Creator:	"Greg Paradis"
	CreationDate:	"Friday, May 04, 2001 12:38:19"
	Comments:	"New forest generation algorithm, featuring square cells. Uses GRID raster file format for increased efficiency."
	GUIName:	"Script"
	Win:	35
	CSMgr:	36
	DocExts:	37
	Source:	"'///////////////////////////////////////////////////////////////////////\n'// FLG.Main\n'///////////////////////////////////////////////////////////////////////\n' CONSTANTS\n'set random number resolution divisor  \nrandResDiv = 100000\n\n'set PATCH TYPES table name\npatchTypeTableName = \"PatchTypeDist\"\n\n'set PATCH TYPES field name\npatchTypeFldName = \"PatchType\"\n\n'set AGE CLASS TABLE NAME field name\nacTabFldName = \"ACTab\"\n\n'set AGE CLASS CUMULATIVE DIST field name\ncumDistFldName = \"CumDist\"\n\n'set AGE CLASS field na
me\nacFldName = \"AgeClass\"\n\n'set Weibull A-parmeter field name\nwAFldName = \"W_a\"\n\n'set Weibull B-parmeter field name\nwBFldName = \"W_b\"\n\n'set Weibull C-parmeter field name\nwCFldName = \"W_c\"\n\n'set default filename prefix\ntheDefaultFileNamePrefix = \"flg\"\n\npatchListExtensionFactor = 1.2\n'///////////////////////////////////////////////////////////////////////\n\n'system.echo(\"Start forest generation\")\n\nstartTime = Date.Now.AsSeconds\n\ntheView = av.GetActiveDoc\n'set view's map units to meters\ntheView.SetUnits(#UNITS_
LINEAR_METERS)\n\nav.GetProject.GetWorkDir.SetCWD\n\ntheGetNeighboursScript = av.FindScript( \"FLG.GetNeighbours\" )  \n\n' INITIALIZE AND DISPLAY USER INPUT DIALOG\n'///////////////////////////////////////////////////////////////////////\n' restore defaults from file\npdList = List.Make\nlf = LineFile.Make( \"patch.dat\".AsFileName, #FILE_PERM_READ )\nif (lf = nil) then\n  pdList = {}\nelse\n  lf.Read(pdList, lf.GetSize )\n  lf.Close\nend\n\ndefList = List.Make\nfor each i in pdList\n  defList.Add(i.AsString)\nend \n\nlabelList = {\"
Max daughters\",\"cellSize (ha)\",\"cols\",\"rows\",\"originX\",\"originY\"}\npdList = MsgBox.MultiInput(\"Patch Data\", \"Enter patch data or click OK to accept defaults\", labelList, defList)\n' kick out if user cancels msgbox\nif (pdlist.Count = 0) then\n  exit\nend\n\n' write new defaults to file\nlf = LineFile.Make( \"patch.dat\".AsFileName, #FILE_PERM_WRITE )\nfor each i in pdList\n  lf.WriteElt(i)\nend\nlf.Close\n\n' READ IN MODEL PARAMETERS FROM DIALOG INPUTS\n'//////////////////////////////////////////////////////////////////////
/\nmaxDaughters = pdList.Get(0).AsNumber\ncellSizeHa = pdList.Get(1).AsNumber\ncellSizeMeters = cellSizeHa.Sqrt * 100\n\n_numX = pdList.Get(2).AsNumber\n_numY = pdList.Get(3).AsNumber\nxllCorner = pdList.Get(4)\nyllCorner = pdList.Get(5)\n\n_cellCount = _numX * _numY\n\n\n' CREATE A VTAB TO STORE PATCH ATTRIBUTES\n'///////////////////////////////////////////////////////////////////////\n' create new fields\ntheVTab = VTab.MakeNew( FileName.GetCWD.MakeTmp(\"patch\", \"dbf\"), dBASE )\npatchIDField = Field.Make(\"PatchID\", #FIELD_
DECIMAL, 8, 0)\npatchTypeField = Field.Make(\"PatchType\", #FIELD_CHAR , 10, 0)\nageClassField = Field.Make(\"AgeClass\", #FIELD_DECIMAL, 8, 0)\nstratumCodeField = Field.Make(\"StratumCode\", #FIELD_CHAR, 16, 0)\n\ntheVTabAddedFieldList = {patchIDField, patchTypeField, ageClassField, stratumCodeField}\ntheVTab.AddFields( theVTabAddedFieldList )\n\n\n' GENERATE AND SORT ATTRIBUTE SAMPLES LIST\n'///////////////////////////////////////////////////////////////////////\n_thePatchList = List.Make\n\nalloCellCount = 0\n_patchTypeVTab
 = av.FindDoc(patchTypeTableName).GetVTab\ndone = false\n\n' clear status bar and message area\nav.ClearStatus\nav.ClearMsg\nav.ShowStopButton\n\nwhile (done.Not)\n\n  av.ShowMsg(\"Generating patch attribute list...\")\n  ''system.echo(\"Generating patch #\"++(_thePatchList.Count + 1).AsString)\n\n  'GET A PATCH TYPE\n  r1 = Number.MakeRandom(0, randResDiv) / randResDiv\n  found = false\n  i = 0\n\n  while (found.Not)\n    tempDist = _patchTypeVTab.ReturnValue(_patchTypeVTab.FindField(cumDistFldName), i)\n    \n    if (tempDist >=
r1) then\n      patchTypeString = _patchTypeVTab.ReturnValue(_patchTypeVTab.FindField(patchTypeFldName), i)\n      found = true\n    end\n    \n    if (found) then\n      \n      'read age class table name for this patch type\n      acTabName = _patchTypeVTab.ReturnValue(_patchTypeVTab.FindField(acTabFldName), i)\n      acTab = av.FindDoc(acTabName).GetVTab\n\n      \n      ' read Weibull function parameters\n      wA = _patchTypeVTab.ReturnValue(_patchTypeVTab.FindField(wAFldName), i) / cellSizeHa\n      wB = _patchType
VTab.ReturnValue(_patchTypeVTab.FindField(wBFldName), i) / cellSizeHa\n      wC = _patchTypeVTab.ReturnValue(_patchTypeVTab.FindField(wCFldName), i)\n      \n      ' calculate bound from maxDaughters\n      bound = Number.GetEuler^((((maxDaughters - wA)/wB)^wC).Negate)\n      d = ((((bound).Ln).Negate^(1/wC)) * wB) + wA\n      bound = (1 - bound) * randResDiv\n\n    end\n    \n    i = i + 1\n  end\n  \n  'GET AN AGE CLASS\n  r2 = Number.MakeRandom(0, randResDiv) / randResDiv\n  i = 0\n  found = false\n  while (found.Not)\n
  tempDist = acTab.ReturnValue(acTab.FindField(cumDistFldName), i)\n    if (tempDist >= r2) then\n      ageClass = acTab.ReturnValue(acTab.FindField(acFldName), i)\n      found = true\n    end\n    i = i + 1\n  end\n  \n  ' GENERATE PATCH SIZE FROM WEIBULL DISTRIBUTION \n  r3 = Number.MakeRandom(0, bound) / randResDiv\n  daughters = ((((-1 * (1-r3).Ln)^(1/wC)) * wB) + wA).Round\n \n  alloCellCount = alloCellCount + daughters\n  \n  \n  if (alloCellCount > (_cellCount * patchListExtensionFactor)) then\n    done = true\n    '
'system.echo(alloCellCount.AsString++\"of\"++_cellCount.AsString++\"cells allocated (\"++( (alloCellCount /  _cellCount) * 100).AsString++\"%)\")\n  end\n  \n  tmpList = List.Make\n  tmpList = { patchTypeString, ageClass, daughters }\n  _thePatchList.Add (tmpList)\n  \n  doMore = av.SetStatus( (alloCellCount / (_cellCount * patchListExtensionFactor) ) * 100 )  \n  if (not doMore) then\n    if (MsgBox.YesNo (\"Quit landscape generation?\", \"FLG\", FALSE)) then\n      av.ClearMsg\n      av.ClearStatus\n      exit\n    end\n  end\n
\nend ' while (done.Not)\n\nav.ClearStatus\n\n' DECLARE DLL AND DLL PROCEDURES\nav.ShowMsg(\"Loading flg.dll...\")\n\nflgDLL = DLL.Make(\"c:\\program files\\flg\\flg21.dll\".AsFileName)\n_passList = DLLProc.Make(flgDLL, \"LoadData\", #DLLPROC_TYPE_VOID,{ #DLLPROC_TYPE_INT32, #DLLPROC_TYPE_INT32, #DLLPROC_TYPE_INT32 }) \n_getType = DLLProc.Make(flgDLL, \"GetPatchType\", #DLLPROC_TYPE_STR,{ #DLLPROC_TYPE_INT32}) \n_getAge = DLLProc.Make(flgDLL, \"GetPatchAge\", #DLLPROC_TYPE_INT32,{ #DLLPROC_TYPE_INT32}) \n_getSize = DLLProc.Make(flg
DLL, \"GetPatchSize\", #DLLPROC_TYPE_INT32,{ #DLLPROC_TYPE_INT32}) \n\n' SORT LIST BY PATCH SIZE (Ascending)\nav.ShowMsg(\"Sorting patch attribute list...\")\n_passList.Call({_thePatchList.Count, _numX, _numY})\n\nav.ShowMsg(\"Preparing to generate landscape...\")\n\n' initialize bitmap by setting all bits...\n' allocation is done when all bits have been flipped off\n'( i.e. theBitMap.Count > 0 )\ntheBitMap = Bitmap.Make( _cellCount )\ntheBitMap.SetAll\ntheRasterCellList = List.Make\nfor each i in 1.._cellCount\n  ' fill theRas
terCellList will -99's\n  theRasterCellList.Add( -99 )\nend\n\ncurrentPatchID = 1\nthePatchCellIDList = List.Make\ntheGrowthCellIDList = List.Make\npatchArrIndex = _thePatchList.Count\n\nwhile ( theBitMap.Count > 1 )\n  \n  av.ShowMsg(\"Growing patch \" ++ currentPatchID.AsString + \" ...  (\" + ((1 - (theBitMap.Count / _cellCount)) * 100).Floor.AsString ++ \"% of landscape allocated)\" )\n  av.ClearStatus\n  av.ShowStopButton\n'///////////////////////////////////////////////////////////////////////\n' DEBUG CODE\n  'system.echo
(\"Generating patch \" + currentPatchID.AsString + \" of \" + _thePatchList.Count.AsString)\n  'system.echo(\"theBitMap.Count: \" + theBitMap.Count.AsString)\n'///////////////////////////////////////////////////////////////////////\n\n  patchArrIndex = patchArrIndex - 1\n  \n  theMotherBitOffset = -1\n\n  while (theMotherBitOffset = -1)\n  motherRank = Number.MakeRandom(1, theBitMap.Count - 1)\n  \n  theMotherBitOffset = theBitMap.GetNextSet(-1)\n  for each i in 1..motherRank By 1\n    theMotherBitOffSet = theBitMap.GetNextSe
t(theMotherBitOffset)\n  end\n  end\n\n  ' check for end of _thePatchList\n  if ( patchArrIndex >= 0 ) then\n    ' get next item in the patch array (LARGEST -> SMALLEST)\n    arrIndex = patchArrIndex\n    backup = false\n  else\n    ' get a random item from the patch array\n    arrIndex = Number.MakeRandom(0, _thePatchList.Count - 1)\n    backup = true\n  end\n\n  ' get patch attributes\n  patchTypeString = _getType.Call({arrIndex})\n  ageClass = _getAge.Call({arrIndex})\n  daughters = _getSize.Call({arrIndex})\n  \n  ' grow p
atch\n  growing = true\n  \n  ' empty cell lists\n  thePatchCellIDList.Empty\n  theGrowthCellIDList.Empty\n  \n  ' initialize theGrowthCellIDList with theMotherBitOffset\n  theGrowthCellIDList.Add( theMotherBitOffset )\n  thePatchCellIDList.Add( theMotherBitOffset )\n  theBitMap.Clear( theMotherBitOffset )\n  \n  while (growing)\n    ' select unallocated cells adjacent to current patch\n    for each cellID in theGrowthCellIDList\n      theNeighbourList = theGetNeighboursScript.DoIt( {cellID, theBitMap} )\n      for each nI
D in theNeighbourList\n        theBitMap.Clear( nID )\n        theGrowthCellIDList.Merge( theNeighbourList )\n        theGrowthCellIDList.RemoveDuplicates\n        theGrowthCellIDList = theGrowthCellIDList - thePatchCellIDList  \n      end  \n    end\n\n    theGrowthCellIDList.RemoveDuplicates\n    thePatchCellIDList.Merge( theGrowthCellIDList )\n\n\n    ' RANDOMIZE PATCH SHAPE\n    '///////////////////////////////////////////////////////////////////////\n    ' the following parameters can be modified to adjust randomiza
tion:\n    p1 = 0.1  'change in randomization throughout patch growth\n    p2 = 0.5  'change in randomization throughout landscape generation\n\n    ' remove a random subset of theGrowthList\n    cellsToRemove = (theGrowthCellIDList.Count * ((1 - (thePatchCellIDList.Count / daughters))^p1 ) * ((theBitMap.Count / theBitMap.GetSize)^p2 )).Floor\n\n    for each i in 1 .. cellsToRemove By 1\n      removeCellID = Number.MakeRandom(0, theGrowthCellIDList.Count - 1)\n      theGrowthCellIDList.Remove( removeCellID )\n      t
heBitMap.Set( removeCellID )\n    end\n\n    thePatchCellIDList.Merge( theGrowthCellIDList )\n    \n    if ( theGrowthCellIDList.Count = 0 ) then\n      growing = false\n    else\n      if ( thePatchCellIDList.Count >= daughters ) then\n        growing = false\n      end\n    end\n    \n    p = ((thePatchCellIDList.Count / daughters) * 100).Floor\n    doMore = av.SetStatus( p )\n    if (not doMore) then\n      if (MsgBox.YesNo (\"Quit landscape generation?\", \"FLG\", FALSE)) then\n        av.ClearMsg\n        av.ClearStatus\n
     exit\n      end\n    end\n         \n  end 'while (growing)\n   \n  ' SET VTAB ATTRIBUTES FOR NEW PATCH\n  rec = theVTab.AddRecord\n  theVTab.SetValue(patchIDField, rec, currentPatchID)\n  theVTab.SetValue(patchTypeField, rec, patchTypeString)\n  theVTab.SetValue(ageClassField, rec, ageClass)\n  theVTab.SetValue(stratumCodeField, rec, patchTypeString + ageClass.AsString)\n\n  for each cellID in thePatchCellIDList\n    theRasterCellList.Set( cellID, currentPatchID )\n  end\n  \n  ' increment patch counter\n  currentPatch
ID  = currentPatchID + 1\n  \n  ''system.echo(((1 - (theBitMap.Count / _cellCount)) * 100 ).asstring)\n  \n  \nend ' while ( theBitMap.Count > 1 )\n\n'system.echo(\"create ASCII file\")\n\n' OUTPUT PATCH ID'S TO ASCII RASTER FILE\n' create LineFile to store the raster cell matrix\ntheASCIIFileName = FileName.GetCWD.MakeTmp(theDefaultFileNamePrefix, \"asc\" )\ntheLineFile = LineFile.Make( theASCIIFileName, #FILE_PERM_WRITE )\n\n' write header data to theLineFile\ntheLineFile.WriteElt( \"ncols\" ++ _numX.AsString )\ntheLineFile.Wr
iteElt( \"nrows\" ++ _numY.AsString )\ntheLineFile.WriteElt( \"xllcorner\" ++ xllCorner )\ntheLineFile.WriteElt( \"yllcorner\" ++ yllCorner )\ntheLineFile.WriteElt( \"cellSize\" ++ cellSizeMeters.AsString )\ntheLineFile.WriteElt( \"nodata_value -99\" )\n\n' convert theRasterCellList into theLineList\nlistIndex = 0\n\ntheLineList = List.Make\nfor each i in 1 .. _numY\n  theLineString = \"\"\n  for each j in 1 .. _numX\n    theLineString = theLineString ++ theRasterCellList.Get(listIndex).AsString\n    listIndex = listIndex + 1\n  end\n
  theLineList.Add(theLineString)\nend\n\ntheLineFile.Write(theLineList, _numY)\ntheLineFile.Close\n\n'system.echo(\"create GRID file\")\n\n' strip the extension from the ACSCII file basename\ntheTmpPrefix = theASCIIFileName.GetBaseName.Left(theASCIIFileName.GetBaseName.Count - 4) \ndef = FileName.Merge(FileName.GetCWD.AsString, theTmpPrefix)\ntheGridFileName = SourceManager.PutDataSet(GRID,\"Import Grid from ASCII file -\" ++ theASCIIFileName.GetBaseName, def,TRUE)\n\n' READ ASCII RASTER FILE INTO ESRI GRID FORMAT\ntheGrid =
 Grid.MakeFromASCII (theASCIIFileName, FALSE)\n\n' SAVE GRID\nstatus = Grid.GetVerify\nGrid.SetVerify(#GRID_VERIFY_OFF)\ntheGrid.SaveDataSet(theGridFileName)\nGrid.SetVerify(status)\n\n' was there a problem?\nif (theGrid.HasError) then\n  MsgBox.Error(\"File\" ++ theASCIIFileName.GetBaseName ++ \"cannot be imported as a Grid\", \"Import Error\")\n  exit\nend\n\n'system.echo(\"export to polygon FTAB\")\n' EXPORT GRID TO POLYGON FTAB\n\ntheTmpPolyFileName = FileName.GetCWD.MakeTmp(\"flg\", \"shp\")\ntheTmpFTab = theGrid.AsPolygonFTab( the
TmpPolyFileName, TRUE, Prj.MakeNull )\n\nif (theTmpFTab.HasError) then\n  MsgBox.Error(\"File\" ++ theGridFileName.GetBaseName ++ \"cannot be converted to a Shapefile\", \"Conversion Error\")\n  ' try to delete the bad file\n  if (File.CanDelete( theTmpPolyFileName ) )then\n    File.Delete( theTmpPolyFileName )\n  end\nend\n\n' copy filename used for the grid file and change the extension to shp\ndef = theGridFileName.Clone\ndef.SetExtension(\"shp\")\n' get a filename for the shapefile\nthePolyFileName = SourceManager.PutDataSet
(FTab,\"Save Shapefile -\" ++ theGridFileName.GetBaseName, def,TRUE)\n\ntheTmpFTabShapeField = theTmpFTab.FindField( \"Shape\" )\ntheTmpFTabGridCodeField = theTmpFTab.FindField( \"GridCode\" )\n\ntheFTab = theTmpFTab.Summarize(thePolyFileName, Shape, theTmpFTabGridCodeField, {theTmpFTabShapeField}, {#VTAB_SUMMARY_AVG})\ntheFTab.CreateIndex( theFTab.FindField( \"Shape\") )\n\n' create new Area field, and add to theVTab\ntheAreaField = Field.Make(\"Area\", #FIELD_DECIMAL, 16, 2)\ntheVTab.AddFields({theAreaField})\n' get a fresh c
opy of field list (with area field)\ntheVTabAddedFieldList = theVTab.GetFields\ntheFTabAddedFieldList = theVTabAddedFieldList.DeepClone\n\ntheGridVTab = theGrid.GetVTab\ntheGridVTabCountField = theGridVTab.FindField( \"Count\" )\n' calculate patch areas from cell counts and cell size\nfor each rec in theGridVTab\n  patchArea = theGridVTab.ReturnValue( theGridVTabCountField, rec ) * cellSizeHa\n  theVTab.SetValue(theAreaField, rec, patchArea)  \nend\n\nfor each rec in theVTab\n'    'system.echo( theVTab.ReturnValue(theArea
Field, rec).asstring)\nend\n\ntheFTabCountField = theFTab.FindField( \"Count\" )\ntheFTabGridCodeField = theFTab.FindField( \"GridCode\" )\ntheFTab.SetEditable( TRUE )\nif ( theFTab.IsEditable ) then\n  \n  ' add the same fields used in theVTab earlier\n  theFTab.AddFields( theFTabAddedFieldList )\n\n  ' loop through theFTab and copy values from the theVTab\n  for each rec in theFTab\n    theFTab.SetValue(theFTabAddedFieldList.Get(0), rec, theFTab.ReturnValue(theFTabGridCodeField, rec))\n    ' loop through the addedfieldlist
s to copy from vtab to ftab\n    for each i in 0 .. (theVTabAddedFieldList.Count - 1)\n      theFTab.SetValue( theFTabAddedFieldList.Get(i), rec, theVTab.ReturnValue(theVTabAddedFieldList.Get(i), rec))\n    end\n  end\n\n  ' remove unnecessary Count and GridCode fields\n  theFTab.RemoveFields( {theFTabCountField, theFTabGridCodeField} )\n\nend\ntheFTab.SetEditable( FALSE )\n\ntheGTheme = GTheme.Make( theGrid )\ntheFTheme = FTheme.Make( theFTab )\ntheView.AddTheme( theGTheme )\ntheView.AddTheme( theFTheme )\n\nav.GetProject.
SetModified( true )\n\n'///////////////////////////////////////////////////////////////////////\n' DEBUG CODE\n''system.echo(\"Elapsed time: \" + ((Date.Now.AsSeconds - startTime) / 60).AsString + \" minutes\")\n'///////////////////////////////////////////////////////////////////////\n"
	SearchStr:	"flgdll"
	FontSize:	1
)

