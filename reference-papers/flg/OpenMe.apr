(SEd.30
	Name:	"FLG.GetNeighbours"
	CreationDate:	"Friday, January 18, 2002 07:00:11"
	GUIName:	"Script"
	Win:	31
	CSMgr:	32
	DocExts:	33
	Source:	"'CELL NUMBERING PATTERN\n'8  1  2\n'7  0  3\n'6  5  4\n\nthe0CellID = SELF.Get(0)\ntheBitMap = SELF.Get(1)\n\nthe1CellID = the0CellID - _numX\nthe2CellID = the0CellID - _numX + 1\nthe3CellID = the0CellID + 1\nthe4CellID = the0CellID + _numX + 1\nthe5CellID = the0CellID + _numX\nthe6CellID = the0CellID + _numX - 1\nthe7CellID = the0CellID - 1\nthe8CellID = the0CellID - _numX - 1\n\ntheNeighbourList = List.Make\n \n'deduce the relative location on the cell in the matrix\nif (the0CellID = 0) then\n  ' northwest corner\n  'case = 1\n
  theNeighbourList = {the3CellID, the4CellID, the5CellID }\n  \nelseif(the0CellID = (_numX - 1)) then\n  ' northeast corner\n  'case = 2\n'  system.echo(\"\")\n  theNeighbourList = {the5CellID, the6CellID, the7CellID }\n  \nelseif (the0CellID < _numX) then\n  'north edge\n  'case = 3\n  theNeighbourList = {the3CellID, the4CellID, the5CellID, the6CellID, the7CellID }\n  \nelseif (the0CellID = (_cellCount - 1)) then\n  ' southeast corner\n  'case = 4\n  theNeighbourList = {the1CellID, the7CellID, the8CellID }\n    \nelseif ( the
0CellID = (_cellCount - _numX) ) then\n  ' southwest corner\n  'case = 5\n  theNeighbourList = {the1CellID, the2CellID, the3CellID }\nelse\n  ' need to calculate col, row\n  row = ((the0CellID + 1) / _numX).Ceiling\n  col = (the0CellID  - ((row - 1) * _numX) + 1)\n'  system.echo(\"row/col\" ++ row.asstring ++ col.asstring ++ \"x/y\" ++ _numX.asstring ++ _numY.asstring)\n  \n  if ( col = 1 ) then\n    ' west edge\n    'case = 6\n    theNeighbourList = {the1CellID, the2CellID, the3CellID, the4CellID, the5CellID }\n    \n  elsei
f ( col = _numX) then\n    ' east edge\n    'case = 7\n    theNeighbourList = {the1CellID, the5CellID, the6CellID, the7CellID, the8CellID }\n    \n  elseif ( row = _numY ) then\n    ' south edge\n    'case = 8\n    theNeighbourList = {the1CellID, the2CellID, the3CellID, the7CellID, the8CellID }\n    \n  else\n    ' somewhere in the middle\n    theNeighbourList = {the1CellID, the2CellID, the3CellID, the4CellID, the5CellID, the6CellID, the7CellID, the8CellID }\n    \n  end\n  \nend\n\n\nthePassedNeighbourList = List.Make\nfor ea
ch n in theNeighbourList\n  if ( theBitMap.Get(n) ) then\n    thePassedNeighbourList.Add( n )\n  end\nend\n  \nreturn thePassedNeighbourList\n"
	SearchStr:	"west edge"
	FontSize:	1
)

